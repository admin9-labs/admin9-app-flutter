{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admin9.local/schemas/app-config-v1.schema.json",
  "title": "Optional Admin9 App Starter identity and brand configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app", "brand"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "androidApplicationId", "iosBundleId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "androidApplicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "iosBundleId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryPair", "secondaryPair", "fontFamily", "radiusDelta", "logoPath", "launchAssetPath"],
      "properties": {
        "primaryPair": { "$ref": "#/$defs/colorPair" },
        "secondaryPair": { "$ref": "#/$defs/colorPair" },
        "fontFamily": { "type": ["string", "null"], "minLength": 1 },
        "radiusDelta": { "type": "integer", "minimum": -2, "maximum": 2 },
        "logoPath": { "type": "string", "pattern": "^assets/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*\\.png$" },
        "launchAssetPath": { "type": "string", "pattern": "^assets/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*\\.png$" }
      }
    }
  },
  "$defs": {
    "colorPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
        "dark": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
      }
    }
  }
}
